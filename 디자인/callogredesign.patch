+}
+
+.g-media--live {
+  aspect-ratio: 4 / 3;
+}
+
+.g-letter {
+  background: var(--surface-2);
+  border-radius: var(--r-sm);
+  padding: 12px;
+  margin-bottom: 12px;
+}
+
+.g-letter-title {
+  margin-bottom: 8px;
+  font-size: 14.5px;
+  font-weight: 600;
+}
+
+.g-letter .g-media {
   margin-bottom: 8px;
 }
+
+/* ===== 추이 차트 ===== */
+
+.g-trend {
+  width: 100%;
+  height: auto;
+  display: block;
+}
+
+.g-questions {
+  margin: 0;
+  padding-left: 20px;
+  font-size: 14px;
+  line-height: 1.7;
+}
+
+/* ===== 약관 본문 ===== */
+
+.g-terms-section {
+  margin-bottom: 22px;
+}
+
+.g-terms-heading {
+  font-size: 15px;
+  font-weight: 700;
+  color: var(--text);
+  margin: 0 0 6px;
+}
+
+.g-terms-section p {
+  font-size: 13.5px;
+  line-height: 1.75;
+  color: var(--text-2);
+  margin: 0 0 8px;
+}
+
+/* 영상편지 안의 삭제는 되돌릴 수 없는 동작이라 눈에 띄어야 하지만, 카드 폭을 다 차지할
+   만큼 중요한 동작은 아니다. 오른쪽에 작게 붙인다. */
+.g-letter .g-button--danger {
+  width: auto;
+  margin-left: auto;
+  padding: 7px 14px;
+  font-size: 13px;
+}
